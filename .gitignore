# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Runtime data — never commit raw pulls or processed artifacts
schism/data/raw/*
!schism/data/raw/.gitkeep
schism/data/processed/*
!schism/data/processed/.gitkeep

# Runtime outputs — never commit generated artifacts or gate results
schism/outputs/stress_test/*
!schism/outputs/stress_test/.gitkeep
schism/outputs/*.json
schism/outputs/*.pkl
schism/outputs/*.npy
schism/outputs/*.npz

